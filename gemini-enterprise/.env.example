# === Deployment target ===
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1
STAGING_BUCKET=gs://document-validator-staging-your-project-id

# gcs_state.py and job_store.py persist session files/state across container
# instance swaps in gs://document-validator-sessions-${GOOGLE_CLOUD_PROJECT}.
# Run ../setup.sh to provision both buckets and IAM roles automatically.

# Auto-filled by deploy.sh after the first successful deploy. Leave empty to
# create a new Agent Runtime instance; once set, redeploys update this same
# instance (new revision) instead of creating a new one. Clear this value to
# force a brand new instance on the next deploy.
AGENT_ENGINE_ID=

# Optional Gemini Enterprise App ID for automated registration via deploy.sh
GEMINI_ENTERPRISE_APP_ID=
GEMINI_ENTERPRISE_LOCATION=global

# Optional: enables the fetch_drive_file_oauth tool (agent/drive_tool.py), which
# accesses Drive as the signed-in user instead of the deployed service account.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# === Container resources (Agent Runtime) ===
AGENT_CPU=8
AGENT_MEMORY=32Gi
PDF_EXTRACT_WORKERS=4
PDF_PAGE_TIMEOUT_SECONDS=30

# === Model ===
MODEL_LOCATION=global
MODEL=gemini-3.8-flash
THINKING_LEVEL=MEDIUM

# === Agent behavior ===
SCRIPT_TIMEOUT_SECONDS=300
